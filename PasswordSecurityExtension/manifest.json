{
    "manifest_version": 3,
    "name": "Password Security Checker",
    "version": "1.0.0",
    "description": "Real-time password strength, pattern, and breach detection.",
    "permissions": [],
    "host_permissions": [
      "https://api.pwnedpasswords.com/*"
    ],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["style.css"],
        "run_at": "document_idle"
      }
    ]
  }